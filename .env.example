# Root overview of all environment variables used across DeutschFlow.
# This file documents variables only — it never contains real values.
# Copy the app-specific .env.example files instead:
#   packages/database/.env.example -> packages/database/.env
#   apps/api/.env.example          -> apps/api/.env
#   apps/web/.env.example          -> apps/web/.env.local
#
# NEVER commit a real .env file. NEVER put server-only secrets in
# apps/web (only NEXT_PUBLIC_* variables are safe there).

# --- Shared / Database (server-only) ---
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- API (server-only) ---
NODE_ENV=
PORT=
# Must match apps/web's SERVICE_TOKEN_SECRET exactly.
SERVICE_TOKEN_SECRET=

# --- API / AI Learning System (server-only, apps/api only — never apps/web) ---
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional, both default sensibly if unset — see apps/api/.env.example.
ANTHROPIC_TIMEOUT_MS=
ANTHROPIC_MAX_RETRIES=

# --- Web (server-only) ---
APP_URL=
NEST_API_URL=
# Must match apps/api's SERVICE_TOKEN_SECRET exactly.
SERVICE_TOKEN_SECRET=

# --- Web (public, exposed to the browser) ---
NEXT_PUBLIC_API_URL=
# Stripe publishable key (test-mode only), mirrors apps/api's
# STRIPE_PUBLISHABLE_KEY. Used by the booking-payment Stripe Elements form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

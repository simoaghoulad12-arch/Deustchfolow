# Supabase (Dashboard → Project Settings → API). Lokal: Werte aus `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur auf dem Server (Vercel: nicht als NEXT_PUBLIC_ setzen!). Wird nur für Einladungen verwendet.
SUPABASE_SERVICE_ROLE_KEY=
# Öffentliche Adresse der App, Ziel der Links in Einladungs- und Anmelde-E-Mails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy to apps/api/.env for local development.
# NEVER commit the real .env file or real credentials.

NODE_ENV="development"
PORT=4000

# Provided by packages/database — see packages/database/.env.example.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"

# Shared secret used to verify the short-lived service token sent by
# Next.js (see apps/web/.env.example). Must be identical in both apps.
# Generate with: openssl rand -base64 32
SERVICE_TOKEN_SECRET=""

# --- AI Learning System (server-only — never exposed to apps/web or the browser) ---

# Which AIProvider implementation AiProviderFactory returns. Currently
# only "claude" is implemented; the abstraction exists so a future
# provider (OpenAI, local model, ...) can be added without touching the
# Learning Engine or any AI service consumer.
AI_PROVIDER="claude"

# Claude API key (console.anthropic.com). Read only via process.env in
# ClaudeProvider — never logged, never sent to the client.
ANTHROPIC_API_KEY=""

# Optional override of the Claude model id used by ClaudeProvider.
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=""

# Optional: per-request timeout for the Claude client, in milliseconds.
# Defaults to 30000 (30s) if unset — the SDK's own default (10 minutes)
# is far too long for an interactive tutor/writing request.
ANTHROPIC_TIMEOUT_MS=""

# Optional: max automatic retries for transient provider failures
# (429/5xx/connection errors), handled by @anthropic-ai/sdk's own
# built-in retry logic. Defaults to 2 if unset.
ANTHROPIC_MAX_RETRIES=""

# --- Payments (Phase 6 — Stripe TEST/SANDBOX only; never a live key here) ---

# Secret key from a Stripe TEST account (dashboard.stripe.com, test
# mode). Must start with "sk_test_" — StripeService refuses to
# construct a client for a "sk_live_" key in this phase. Read only via
# process.env in StripeService — never logged, never sent to the client.
STRIPE_SECRET_KEY=""

# Publishable key, safe to expose to the browser (Stripe.js/Elements
# needs it for the booking-payment card form). Test mode: "pk_test_...".
# This is the one Stripe credential apps/web is allowed to hold, and
# only as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY there.
STRIPE_PUBLISHABLE_KEY=""

# Signing secret for the main (platform) webhook endpoint
# (POST /payments/webhooks/stripe). From the Stripe CLI
# (`stripe listen --print-secret`) for local dev, or the Stripe
# dashboard's webhook endpoint configuration otherwise.
STRIPE_WEBHOOK_SECRET=""

# Signing secret for the separate Connect webhook endpoint
# (POST /payments/webhooks/stripe-connect) — Stripe delivers
# connected-account events as a logically distinct webhook subscription
# from platform events, even though both hit this server.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Stripe Price ids for the paid plans (created in the Stripe TEST
# dashboard: Product catalog). Plan -> Price mapping is deploy-time
# config, not a database row — matches how AI_PROVIDER etc. are
# configured today.
STRIPE_PRICE_ID_PREMIUM=""
STRIPE_PRICE_ID_PRO=""

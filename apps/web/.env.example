# Copy to apps/web/.env.local for local development.
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put
# server-only secrets (API keys, DB credentials) in this file.

# Currently unused by any code in apps/web — the browser never calls
# apps/api directly (see NEST_API_URL below, server-only). Kept only
# because CI sets it as a harmless placeholder. Safe to leave unset.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Publishable key from a Stripe TEST account (dashboard.stripe.com, test
# mode) — test mode: "pk_test_...". Safe to expose to the browser by
# design (Stripe.js/Elements needs it to render the booking-payment card
# form on /bookings/[bookingId]/pay). This is the ONE Stripe credential
# apps/web is allowed to hold, and only as NEXT_PUBLIC_ here — the
# secret key (STRIPE_SECRET_KEY) lives only in apps/api/.env, never here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Server-only (never exposed to the browser) ---

# Same database as packages/database — Next.js owns Authentication and
# reads/writes User/Session/... directly (see architecture decision
# record, section 4).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"

# Base URL of this app, used to build links in emails (verification,
# password reset). No trailing slash.
APP_URL="http://localhost:3000"

# Internal URL Next.js uses to call NestJS server-to-server. Never
# NEXT_PUBLIC_ — the browser must never call NestJS directly.
NEST_API_URL="http://localhost:4000/api/v1"

# Shared secret used to sign/verify the short-lived service token between
# Next.js and NestJS. Must be identical here and in apps/api/.env. Generate
# with: openssl rand -base64 32
SERVICE_TOKEN_SECRET=""

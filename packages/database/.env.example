# Copy to packages/database/.env for local development.
# NEVER commit the real .env file or real credentials.

# Standard PostgreSQL connection (used by Prisma Client at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"

# Direct (non-pooled) connection, used for migrations when DATABASE_URL
# points at a connection pooler (e.g. PgBouncer) in production.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschflow?schema=public"

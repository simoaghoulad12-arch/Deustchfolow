// DeutschFlow – Phase 2 schema: Identity, Authentication, Learning Profile,
// Subscription. See docs/architecture-decisions/phase-1.5-identity-auth-entitlements.md
// for the architecture this implements. Entitlements are intentionally NOT a
// database table in this phase — they are derived from Subscription.plan via
// a central PLAN_ENTITLEMENTS config (see packages/types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  CONTENT_EDITOR
  SUPPORT
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PRO
}

/// Stripe's own subscription lifecycle, adopted verbatim (see phase-6
/// implementation notes for why the previous 3-value enum was replaced
/// rather than extended — it could not represent PAST_DUE/TRIALING/
/// INCOMPLETE, which dunning logic and entitlement grace periods need).
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
}

enum LearningSkill {
  GRAMMAR
  VOCABULARY
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRANSLATION
  TRUE_FALSE
  ORDER_WORDS
  SHORT_ANSWER
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VocabularyStatus {
  NEW
  LEARNING
  MASTERED
}

enum ConversationRole {
  USER
  ASSISTANT
}

/// Identity + authentication. Deliberately minimal — display data lives in
/// UserProfile, learning state in LearningProfile (see architecture decision
/// record, section 5).
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String    @map("password_hash")

  role Role @default(STUDENT)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile             UserProfile?
  learningProfile     LearningProfile?
  subscriptions       Subscription[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  accounts            Account[]

  exerciseAttempts  ExerciseAttempt[]
  lessonProgress    LessonProgress[]
  skillProgress     UserSkillProgress[]
  vocabularyEntries UserVocabulary[]

  conversationSessions ConversationSession[]
  writingSubmissions   WritingSubmission[]
  aiUsageRecords       AiUsageRecord[]

  /// 1:1 marketplace profile — only meaningful when role = TUTOR, but kept
  /// as an optional relation (not a role-gated table) so a user who
  /// changes role never loses history (see architecture decision record).
  tutorProfile TutorProfile?

  studentBookings      Booking[]             @relation("StudentBookings")
  reviewsWritten       Review[]
  documentRequirements DocumentRequirement[]
  germanyPath          GermanyPath?

  /// 1:1 — created lazily on first checkout (subscription or booking),
  /// never at registration (see phase-6 implementation notes).
  stripeCustomer   StripeCustomer?
  refundsInitiated Refund[]

  @@index([role])
  @@map("users")
}

/// 1:1 — personal/display data. Kept separate from User so auth-critical
/// code paths never need to load it (data minimization).
model UserProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

/// 1:1 — learning-specific state, owned conceptually by the future learning
/// system. Separated from UserProfile so it can evolve independently.
model LearningProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nativeLanguage      String?    @map("native_language")
  explanationLanguage String?    @map("explanation_language")
  timezone            String?
  learningGoal        String?    @map("learning_goal")
  currentLevel        CEFRLevel? @map("current_level")
  targetLevel         CEFRLevel? @map("target_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("learning_profiles")
}

/// The commercial relationship, deliberately separate from Role. FREE is a
/// real, first-class plan — every user has exactly one active Subscription.
/// Entitlements are derived from `plan`, not stored here (see
/// packages/types PLAN_ENTITLEMENTS).
/// Written by two paths only: the FREE row created at registration
/// (apps/web/lib/auth/register.ts, status always ACTIVE, no Stripe
/// fields) and the Stripe webhook handler (Phase 6.5) for every paid
/// plan. No other code path may set `plan` or `status` — see phase-6
/// implementation notes for why this is the concrete mechanism behind
/// "Entitlements dürfen nicht aus Client-Plan kommen."
model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  /// Null for the FREE plan (no Stripe object exists for it).
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  /// True once the user has requested cancellation but the paid period
  /// hasn't ended yet — still entitled to the plan until then.
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  /// Timestamp status first became PAST_DUE — the grace-period clock
  /// (PaymentPolicy.pastDueGracePeriodDays) counts from here, never from
  /// "now" at read time.
  pastDueSince         DateTime? @map("past_due_since") @db.Timestamptz

  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("subscriptions")
}

/// Single-use, short-TTL, hashed token for password reset. Never store the
/// raw token — only its hash (see lib/auth/tokens.ts).
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Database-backed session. Deleting a row logs that session out
/// immediately — see architecture decision record section 3 for why this
/// was chosen over stateless JWT sessions.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionToken String   @unique @map("session_token")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

/// Reserved for future OAuth providers (Auth.js-compatible shape). Unused
/// in Phase 2 — DeutschFlow only supports email/password login so far.
model Account {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Single-use, short-TTL, hashed token for email verification.
model VerificationToken {
  identifier String
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([identifier, tokenHash])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Phase 3 — Learning Engine.
// Level -> Course -> Module -> Lesson -> Exercise -> Question -> Option.
// See docs/architecture-decisions/phase-3-learning-engine.md for the small
// set of implementation decisions made while building this out (e.g. why
// "Answers" and "Exercise Attempts" are one model, why Course/Module
// progress is computed rather than stored).
// ---------------------------------------------------------------------------

/// One row per CEFR level. `code` reuses the shared CEFRLevel enum rather
/// than a free-text string.
model Level {
  id          String    @id @default(uuid()) @db.Uuid
  code        CEFRLevel @unique
  name        String
  description String?
  order       Int       @unique

  courses Course[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("levels")
}

model Course {
  id      String @id @default(uuid()) @db.Uuid
  levelId String @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  title       String
  slug        String  @unique
  description String?
  order       Int

  modules Module[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([levelId, order])
  @@index([levelId])
  @@map("courses")
}

/// A module groups lessons within a course. Named `Module` for the domain
/// concept — unrelated to NestJS's own `@Module()` decorator.
model Module {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?
  order       Int

  lessons Lesson[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, slug])
  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id       String @id @default(uuid()) @db.Uuid
  moduleId String @db.Uuid
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title            String
  slug             String        @unique
  description      String?
  skill            LearningSkill
  difficulty       Int           @default(1)
  estimatedMinutes Int           @map("estimated_minutes")
  order            Int
  /// Structured, not free-text JSON — a simple string list of learning
  /// objectives (Postgres native array).
  objectives       String[]

  exercises          Exercise[]
  progress           LessonProgress[]
  writingSubmissions WritingSubmission[]

  /// Simple self-relation: this lesson requires the lessons in
  /// `prerequisites` to be completed first. Deliberately not a separate
  /// "requirement rule" model — a plain many-to-many is enough for now.
  prerequisites Lesson[] @relation("LessonPrerequisites")
  unlocks       Lesson[] @relation("LessonPrerequisites")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([moduleId, order])
  @@index([moduleId])
  @@map("lessons")
}

model Exercise {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  type        ExerciseType
  prompt      String
  /// Shown to the student only after they answer — never in the initial
  /// exercise payload (see EntitlementsService-style access discipline in
  /// apps/api/src/modules/learning/exercises).
  explanation String?
  difficulty  Int          @default(1)
  order       Int

  questions Question[]
  attempts  ExerciseAttempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("exercises")
}

/// Structured answer options instead of an unstructured text blob. Most
/// exercises have exactly one Question; the extra level exists so a future
/// multi-part exercise (e.g. several blanks) doesn't need a schema change.
model Question {
  id         String   @id @default(uuid()) @db.Uuid
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  text          String
  order         Int     @default(0)
  /// Expected answer for text-graded types (FILL_BLANK, TRANSLATION,
  /// SHORT_ANSWER). Unused for option-graded types (MULTIPLE_CHOICE,
  /// TRUE_FALSE, ORDER_WORDS), which grade via `Option` rows instead.
  correctAnswer String? @map("correct_answer")

  options Option[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([exerciseId])
  @@map("questions")
}

/// For MULTIPLE_CHOICE/TRUE_FALSE: `isCorrect` marks the right choice. For
/// ORDER_WORDS: `order` is the word's correct position and `isCorrect` is
/// unused. Never sent to students with `isCorrect` populated before they
/// answer — see the exercises service.
model Option {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false) @map("is_correct")
  order     Int     @default(0)

  @@index([questionId])
  @@map("options")
}

/// One event per submitted answer — covers both "Answers" and "Exercise
/// Attempts" from the spec, which describe the same data (see
/// architecture decision record). Immutable once written; no updatedAt.
model ExerciseAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  /// Raw submitted answer: selected Option id for option-graded types, or
  /// free text for text-graded types. Kept as a single string — no nested
  /// JSON needed for one answer per attempt.
  answer        String
  isCorrect     Boolean @map("is_correct")
  attemptNumber Int     @map("attempt_number")
  timeSpentMs   Int?    @map("time_spent_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_attempts")
}

/// The single source of truth for progress. Course/Module-level progress
/// is computed from these rows on read, not stored redundantly (see
/// architecture decision record).
model LessonProgress {
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String @db.Uuid
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  status         ProgressStatus @default(NOT_STARTED)
  /// 0-100, clamped by the service layer — not worth a DB check
  /// constraint for this MVP.
  progress       Int            @default(0)
  completedAt    DateTime?      @map("completed_at")
  lastAccessedAt DateTime?      @map("last_accessed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// Per-skill standing, updated by rule-based logic today and potentially
/// by an AI layer later (see architecture decision record, section 29 —
/// the learning engine itself never depends on that layer existing).
model UserSkillProgress {
  userId String        @db.Uuid
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill  LearningSkill

  level CEFRLevel?
  score Int        @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, skill])
  @@map("user_skill_progress")
}

model Vocabulary {
  id              String    @id @default(uuid()) @db.Uuid
  word            String
  normalizedWord  String    @map("normalized_word")
  translation     String
  level           CEFRLevel
  partOfSpeech    String?   @map("part_of_speech")
  exampleSentence String?   @map("example_sentence")

  userEntries UserVocabulary[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([normalizedWord, level])
  @@index([level])
  @@map("vocabulary")
}

/// Spaced-repetition data only — no algorithm here. `nextReviewAt` is
/// simply a field a future review-scheduling service reads and writes;
/// see architecture decision record / spec section 11.
model UserVocabulary {
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyId String     @db.Uuid
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  status         VocabularyStatus @default(NEW)
  correctCount   Int              @default(0) @map("correct_count")
  incorrectCount Int              @default(0) @map("incorrect_count")
  lastReviewedAt DateTime?        @map("last_reviewed_at")
  nextReviewAt   DateTime?        @map("next_review_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@map("user_vocabulary")
}

// ---------------------------------------------------------------------------
// Phase 4 — AI Learning System.
// The Learning Engine works without this layer (see architecture decision
// record phase-4-ai-learning-system.md, section 30 of the spec: AI
// suggests/analyzes/explains, the Learning Engine decides progress). AI
// never writes to LessonProgress/UserSkillProgress directly — only via
// ProgressService, and AI-generated exercises are never persisted as
// Exercise/Question/Option rows (kept ephemeral in message metadata).
// ---------------------------------------------------------------------------

model ConversationSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  /// Phase 5: when set, this conversation is a Real-Life Simulation run
  /// rather than a general tutor chat. Deliberately reuses this existing
  /// model instead of a parallel "SimulationSession" table — the shape
  /// (userId, role, content, metadata, ownership) is identical; only the
  /// originating catalog entry differs (see architecture decision record).
  simulationId String?     @db.Uuid
  simulation   Simulation? @relation(fields: [simulationId], references: [id])

  messages ConversationMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([simulationId])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id        String              @id @default(uuid()) @db.Uuid
  sessionId String              @db.Uuid
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String

  /// Structured AI response pieces (corrections, suggestedExercise, skill,
  /// level) for ASSISTANT messages only — never used for USER messages.
  /// Kept as Json deliberately: this is diagnostic AI output tied 1:1 to
  /// a single message, not shared curriculum data (see architecture
  /// decision record, section 5).
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("conversation_messages")
}

model WritingSubmission {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String? @db.Uuid
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  text          String
  correctedText String? @map("corrected_text")

  /// Structured list of detected errors (category, original, correction,
  /// explanation, severity) — see architecture decision record, section 5,
  /// for why this is Json rather than child tables.
  errors Json?

  /// The AI's CEFR assessment of this submission. Deliberately NOT written
  /// to LearningProfile.currentLevel automatically (spec section 10) — a
  /// human or a later, separate decision layer acts on it.
  detectedLevel CEFRLevel? @map("detected_level")
  score         Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("writing_submissions")
}

/// One row per AI request that counted against a user's usage limit —
/// event log, not a pre-aggregated counter, so "today's usage" is a
/// simple COUNT(*) query (see architecture decision record, section 3,
/// for why this is DB-backed rather than the in-memory rate limiter).
model AiUsageRecord {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, feature, createdAt])
  @@map("ai_usage_records")
}

// ---------------------------------------------------------------------------
// Phase 5 — Tutor Marketplace + Germany Coach Foundation + Real-Life
// Simulations. See docs/architecture-decisions/phase-5-marketplace-and-
// germany-coach.md for the decisions behind the shapes below (double-booking
// exclusion constraint, timezone storage, document storage abstraction,
// reuse of ConversationSession for simulations, why "Offering" and not
// "Service" as the model name).
// No real payments yet — Booking's shape anticipates Stripe Connect
// (Phase 6) without implementing it.
// ---------------------------------------------------------------------------

enum TutorVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Coarse marketplace categories a tutor/offering can be filtered and
/// discovered by. Deliberately a fixed enum (not free text) so
/// marketplace filters are exact-match, indexable queries.
enum TutorSpecialty {
  CONVERSATION
  EXAM_PREPARATION
  APPLICATION_COACHING
  PRONUNCIATION
  BUSINESS_GERMAN
  EVERYDAY_GERMAN
  PROFESSIONAL_GERMAN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUND_PENDING
  REFUNDED
}

enum GermanyGoalType {
  WORK
  STUDY
  APPRENTICESHIP
  FAMILY
  LANGUAGE
  JOB_SEARCH
  OTHER
}

/// Fixed, ordered path — a deliberately simple linear model, not a
/// workflow engine (spec: "noch keine umfangreiche Rechtsdatenbank
/// bauen, zuerst saubere Architektur"). Order in this enum IS the step
/// order; GermanyPathService computes "done/current/upcoming" from where
/// `currentStep` sits in this list, nothing is stored per-step.
enum GermanyPathStep {
  ORIENTATION
  GERMAN_LEVEL
  QUALIFICATION_CHECK
  JOB_OR_APPRENTICESHIP
  DOCUMENTS
  VISA_RESIDENCE_CHECK
  ENTRY
  FIRST_STEPS
  GERMANY_EVERYDAY_LIFE
}

enum OfficialSourceTopic {
  VISA
  WORK_PERMIT
  RECOGNITION_OF_QUALIFICATIONS
  JOB_SEARCH
  HOUSING
  HEALTH_INSURANCE
  LANGUAGE
  GENERAL
}

enum DocumentRequirementStatus {
  MISSING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  EXPIRED
  NOT_REQUIRED
}

enum SimulationCategory {
  HOUSING
  DOCTOR
  BANK
  GOVERNMENT_OFFICE
  TRANSPORT
  SHOPPING
  PHONE_CALL
  WORK
  STUDY
  PACKAGE
  NEIGHBORS
}

enum CareerModuleType {
  CV
  COVER_LETTER
  INTERVIEW
  WORKPLACE_GERMAN
  PROFESSIONAL_EMAIL
}

/// Marketplace-facing tutor identity. Kept separate from User the same
/// way UserProfile/LearningProfile are (data minimization, independent
/// evolution) — only meaningful once role = TUTOR, but not role-gated at
/// the DB level so a role change never destroys history.
///
/// Every field here is either tutor-provided (never presented as a
/// verified fact by the platform — see TutorsController) or computed on
/// read from real rows (averageRating/completedSessions are NOT stored
/// here — see TutorProfilesService — to avoid a stale-cache-invalidation
/// problem for numbers that must always be accurate).
model TutorProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline        String?
  aboutMe         String?          @db.Text
  languages       String[]
  teachingLevels  CEFRLevel[]      @map("teaching_levels")
  specialties     TutorSpecialty[]
  yearsExperience Int?             @map("years_experience")
  /// IANA timezone, e.g. "Europe/Berlin" — the tutor's own reference
  /// frame for TutorAvailabilityRule (spec section 4: "Speichere intern
  /// UTC, zeige lokal in der Zeitzone des Nutzers" — this is the "local"
  /// side of that for the tutor).
  timezone        String

  verificationStatus TutorVerificationStatus @default(PENDING) @map("verification_status")
  /// Admin kill switch — deactivated tutors disappear from marketplace
  /// listings/search without deleting their history (bookings, reviews).
  isActive           Boolean                 @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verificationDocuments  TutorVerificationDocument[]
  availabilityRules      TutorAvailabilityRule[]
  availabilityExceptions TutorAvailabilityException[]
  offerings              Offering[]
  bookings               Booking[]                    @relation("TutorBookings")
  reviews                Review[]
  /// 1:1 — created lazily when a tutor starts Connect onboarding, not at
  /// profile creation (see phase-6 implementation notes, Phase 6.6).
  connectedAccount       TutorConnectedAccount?

  @@index([verificationStatus])
  @@index([isActive])
  @@map("tutor_profiles")
}

/// Metadata only — the actual bytes live behind DocumentStorageService
/// (private bucket / local dev equivalent, see architecture decision
/// record). `storageKey` is an opaque object key, never a public URL;
/// access is always mediated through a short-lived signed URL minted
/// server-side after an ownership/admin check.
model TutorVerificationDocument {
  id      String       @id @default(uuid()) @db.Uuid
  tutorId String       @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  /// Tutor-supplied label (e.g. "Goethe-Zertifikat C2") — descriptive
  /// only, never itself proof of anything; verification is the admin
  /// decision recorded on TutorProfile.verificationStatus, not per-file.
  label       String
  storageKey  String   @map("storage_key")
  /// MIME type of the stored bytes — needed to serve the file correctly
  /// through the signed-URL download endpoint (Phase 5.6).
  contentType String   @map("content_type")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  @@index([tutorId])
  @@map("tutor_verification_documents")
}

/// Recurring weekly availability, expressed in the tutor's OWN local
/// timezone (TutorProfile.timezone) and weekday — not UTC. Storing it
/// this way (rather than pre-computed UTC windows) is what makes it
/// correctly survive DST: "every Monday 9-17 Berlin time" is a stable
/// rule; its UTC instant shifts twice a year, which is exactly what a
/// naive UTC-stored rule would get wrong. Converted to UTC on read by
/// TutorAvailabilityService using luxon for a specific requested date.
model TutorAvailabilityRule {
  id      String       @id @default(uuid()) @db.Uuid
  tutorId String       @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  /// 0 = Sunday .. 6 = Saturday (JS Date convention), local to the
  /// tutor's timezone.
  weekday     Int
  /// Minutes since local midnight, e.g. 540 = 09:00.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tutorId])
  @@map("tutor_availability_rules")
}

/// A single absolute-time override — vacation/blocked time. Stored as a
/// real UTC instant range (not weekday+minute) since exceptions are
/// concrete dates, not recurring patterns.
model TutorAvailabilityException {
  id      String       @id @default(uuid()) @db.Uuid
  tutorId String       @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  startAt   DateTime @map("start_at") @db.Timestamptz
  endAt     DateTime @map("end_at") @db.Timestamptz
  isBlocked Boolean  @default(true) @map("is_blocked")
  reason    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tutorId, startAt])
  @@map("tutor_availability_exceptions")
}

/// A tutor's bookable offering — deliberately named "Offering", not
/// "Service", to avoid colliding with the unrelated `TutorService`
/// class in apps/api/src/modules/ai (the AI tutor chat service).
model Offering {
  id      String       @id @default(uuid()) @db.Uuid
  tutorId String       @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  title           String
  description     String?        @db.Text
  category        TutorSpecialty
  durationMinutes Int            @map("duration_minutes")
  /// Integer minor units (cents), never a float — no payment processing
  /// yet (Phase 6), but the shape must already be Stripe-Connect-ready.
  priceCents      Int            @map("price_cents")
  currency        String         @default("EUR")
  cefrLevels      CEFRLevel[]    @map("cefr_levels")
  isActive        Boolean        @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([tutorId])
  @@index([isActive])
  @@map("offerings")
}

/// The booking record. Payment fields intentionally absent — Phase 6
/// (Stripe Connect) adds them without reshaping this model (student,
/// tutor, offering, time range, status are already exactly what a
/// payment integration needs to hang off of).
///
/// Double-booking prevention: enforced at the database level via a
/// PostgreSQL EXCLUDE constraint (added by raw SQL in the migration —
/// Prisma's schema DSL cannot express this) on (tutorId, tsrange(startAt,
/// endAt)) WHERE status IN ('PENDING','CONFIRMED'). The application-level
/// pre-check in BookingsService exists only for a fast, friendly error —
/// the DB constraint is the actual race-condition-proof guarantee. See
/// architecture decision record.
model Booking {
  id String @id @default(uuid()) @db.Uuid

  studentId String @db.Uuid
  student   User   @relation("StudentBookings", fields: [studentId], references: [id])

  tutorId String       @db.Uuid
  tutor   TutorProfile @relation("TutorBookings", fields: [tutorId], references: [userId])

  offeringId String   @db.Uuid
  offering   Offering @relation(fields: [offeringId], references: [id])

  startAt         DateTime @map("start_at") @db.Timestamptz
  endAt           DateTime @map("end_at") @db.Timestamptz
  /// IANA timezone the student booked in — display-only, never used for
  /// authorization or overlap logic (which always operates in UTC).
  studentTimezone String   @map("student_timezone")

  status BookingStatus @default(PENDING)

  notes              String? @db.Text
  cancellationReason String? @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review  Review?
  /// 1:1 — created when checkout starts for this booking (Phase 6.7).
  payment Payment?

  @@index([tutorId, startAt])
  @@index([studentId])
  @@index([status])
  @@map("bookings")
}

/// One review per booking, only after COMPLETED (enforced in
/// ReviewsService, not just at the DB level — see architecture decision
/// record for why a partial unique index alone isn't sufficient here).
model Review {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id])

  tutorId String       @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId])

  rating   Int
  comment  String? @db.Text
  isHidden Boolean @default(false) @map("is_hidden")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tutorId])
  @@map("reviews")
}

/// "Wo bin ich auf meinem Weg nach Deutschland?" — one row per user,
/// intentionally minimal (see GermanyPathStep doc comment above for why
/// this isn't a workflow-engine table).
model GermanyPath {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalType    GermanyGoalType @map("goal_type")
  currentStep GermanyPathStep @default(ORIENTATION) @map("current_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("germany_paths")
}

/// A trusted, citable source for Germany-relevant information — the
/// architecture for facts, not the facts themselves (spec section 13:
/// "keine Anforderungen erfinden"). No content/requirement text is
/// invented anywhere in this phase; DocumentRequirement.notes stays
/// free-text/optional until real content is sourced from rows here.
model OfficialSource {
  id             String              @id @default(uuid()) @db.Uuid
  title          String
  url            String
  authority      String
  topic          OfficialSourceTopic
  language       String
  lastVerifiedAt DateTime?           @map("last_verified_at")
  active         Boolean             @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documentRequirements DocumentRequirement[]

  @@index([topic])
  @@index([active])
  @@map("official_sources")
}

/// A document a user may need for their Germany goal. `documentType` and
/// `notes` are deliberately free text at this Foundation stage — actual
/// per-goal requirement rules are future work sourced from
/// OfficialSource rows, never invented here (spec section 14).
model DocumentRequirement {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType String                    @map("document_type")
  goal         GermanyGoalType
  context      String?
  status       DocumentRequirementStatus @default(MISSING)
  sourceId     String?                   @map("source_id") @db.Uuid
  source       OfficialSource?           @relation(fields: [sourceId], references: [id])
  notes        String?                   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("document_requirements")
}

/// Real-Life Simulation catalog entry — content only, no per-user
/// session state stored here (a run is a ConversationSession with
/// simulationId set, see above).
model Simulation {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  category       SimulationCategory
  cefrLevel      CEFRLevel          @map("cefr_level")
  situation      String             @db.Text
  goal           String             @db.Text
  roles          String[]
  expectedSkills LearningSkill[]    @map("expected_skills")
  isActive       Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversationSessions ConversationSession[]

  @@index([category])
  @@index([cefrLevel])
  @@map("simulations")
}

/// Career practice catalog entry — a prepared topic, not an
/// auto-generated deliverable (spec section 16: "noch keine komplexe
/// KI-Automatisierung erzwingen").
model CareerModule {
  id          String           @id @default(uuid()) @db.Uuid
  type        CareerModuleType
  title       String
  description String           @db.Text
  cefrLevel   CEFRLevel?       @map("cefr_level")
  isActive    Boolean          @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("career_modules")
}

// ---------------------------------------------------------------------------
// Phase 6 — Payments & Monetization (Stripe, TEST/SANDBOX only in this
// phase). See docs/architecture-decisions/phase-6-payment-architecture-
// quality-gate.md (approved design) and phase-6-implementation.md (running
// per-subphase decisions) for the reasoning behind every shape below.
//
// The single rule every model here exists to enforce: money status is
// never set by a client-facing write. Subscription.status, Payment.status,
// Refund.status, and TutorConnectedAccount's capability flags are written
// exclusively by the Stripe webhook handler (Phase 6.5) — no other code
// path may set them, whatever a request body claims.
// ---------------------------------------------------------------------------

/// Mirrors a Stripe PaymentIntent's real lifecycle for a one-time
/// marketplace booking payment. Deliberately NOT the same enum as
/// Booking.status (which stays the small, UX-facing enum it already
/// was in Phase 5) — Booking.status is derived FROM this, never the
/// reverse.
enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  CANCELED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

/// Who/what initiated a refund attempt. Deliberately its own enum, not a
/// reuse of Role — SYSTEM covers a future automated path (e.g. an
/// abandoned-booking auto-release), which is not a human role.
enum RefundInitiatorRole {
  STUDENT
  SUPPORT
  ADMIN
  SYSTEM
}

/// Mirrors the Tutor Connect onboarding/capability lifecycle (quality-gate
/// report §3.3). A tutor's offerings are only bookable once this reaches
/// ENABLED — a gate that did not exist before Phase 6.
enum TutorConnectAccountStatus {
  ONBOARDING_INCOMPLETE
  RESTRICTED
  ENABLED
}

enum TutorPayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

/// PENDING -> PROCESSED | FAILED | IGNORED. IGNORED is for event types we
/// deliberately don't handle — still recorded, never silently dropped, so
/// the webhook ledger stays a complete audit trail of everything Stripe
/// ever sent us.
enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

/// 1:1 mirror of a Stripe Customer object. Created lazily on first
/// checkout (subscription OR booking payment) — never at registration,
/// to avoid creating Stripe objects for users who never pay.
model StripeCustomer {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId String @unique @map("stripe_customer_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_customers")
}

/// 1:1 mirror of a Stripe Connect Express account per tutor. Created
/// lazily when a tutor starts onboarding (Phase 6.6), not at
/// TutorProfile creation. Holds capability flags only — never funds;
/// actual money lives in Stripe, this table exists to answer "can this
/// tutor accept bookings" without a live Stripe API call on every
/// marketplace page render.
model TutorConnectedAccount {
  tutorId String       @id @db.Uuid
  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  stripeAccountId  String                    @unique @map("stripe_account_id")
  status           TutorConnectAccountStatus @default(ONBOARDING_INCOMPLETE)
  chargesEnabled   Boolean                   @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean                   @default(false) @map("payouts_enabled")
  detailsSubmitted Boolean                   @default(false) @map("details_submitted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payouts TutorPayout[]

  @@index([status])
  @@map("tutor_connected_accounts")
}

/// One row per marketplace booking payment (1:1 with Booking). The
/// authoritative record Booking.status's payment-related transitions are
/// derived from — see PaymentStatus doc comment.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  stripePaymentIntentId String  @unique @map("stripe_payment_intent_id")
  stripeChargeId        String? @map("stripe_charge_id")

  amountCents         Int    @map("amount_cents")
  /// Platform commission actually charged on this payment, in cents —
  /// captured at charge time from PaymentPolicy.commissionBasisPoints so
  /// a later policy change never rewrites historical payments.
  applicationFeeCents Int    @map("application_fee_cents")
  currency            String @default("EUR")

  status PaymentStatus @default(REQUIRES_PAYMENT_METHOD)

  disputedAt    DateTime? @map("disputed_at") @db.Timestamptz
  disputeStatus String?   @map("dispute_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refunds Refund[]
  payouts TutorPayout[]

  @@index([status])
  @@map("payments")
}

/// One row per refund ATTEMPT against a Payment — a Payment may have more
/// than one (e.g. a partial refund followed later by the remainder).
model Refund {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Null until Stripe assigns one — the row is created locally first
  /// (status PENDING) so the intent to refund is recorded even if the
  /// subsequent Stripe API call fails.
  stripeRefundId String?      @unique @map("stripe_refund_id")
  amountCents    Int          @map("amount_cents")
  status         RefundStatus @default(PENDING)
  reason         String?

  initiatedByUserId     String              @map("initiated_by_user_id") @db.Uuid
  initiatedByUser       User                @relation(fields: [initiatedByUserId], references: [id])
  initiatedByRole       RefundInitiatorRole @map("initiated_by_role")
  /// True when this refund exceeded PaymentPolicy.supportRefundLimitCents
  /// (or was otherwise exceptional) and therefore required ADMIN approval
  /// rather than SUPPORT's standing authority — an audit trail of WHY an
  /// escalation happened, not just that it did.
  requiredAdminApproval Boolean             @default(false) @map("required_admin_approval")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([paymentId])
  @@map("refunds")
}

/// Local reconciliation ledger for money moving from the platform's
/// Stripe balance to a tutor's connected account / bank. Stripe itself
/// (via Connect's automatic payout schedule) actually moves the money —
/// this table is a read-only mirror populated by Connect webhook events,
/// never an orchestration engine, and never writable via any
/// client-triggerable endpoint (see quality-gate report §13: "Keine
/// Tutor-Auszahlung darf clientseitig ausgelöst werden").
model TutorPayout {
  id String @id @default(uuid()) @db.Uuid

  tutorId      String                @db.Uuid
  tutorAccount TutorConnectedAccount @relation(fields: [tutorId], references: [tutorId], onDelete: Cascade)

  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id])

  stripeTransferId String? @unique @map("stripe_transfer_id")
  stripePayoutId   String? @unique @map("stripe_payout_id")

  amountCents Int               @map("amount_cents")
  currency    String            @default("EUR")
  status      TutorPayoutStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tutorId])
  @@map("tutor_payouts")
}

/// Append-only ledger, one row per RECEIVED Stripe event id. The entire
/// idempotency guarantee for the whole payment system lives in the
/// unique constraint on stripeEventId below — a duplicate/replayed
/// webhook is absorbed here before any business logic runs (see
/// quality-gate report §5).
model StripeWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  stripeEventId String @unique @map("stripe_event_id")
  type          String
  /// Full raw event JSON from Stripe — retained only for a short window
  /// per the data-minimization note in the quality-gate report §23; the
  /// derived rows in Payment/Subscription/Refund/TutorPayout are the
  /// long-lived record, not this payload.
  payload       Json

  status          WebhookProcessingStatus @default(PENDING)
  processingError String?                 @map("processing_error")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([type])
  @@index([status])
  @@map("stripe_webhook_events")
}

/// Singleton config row (id is always the fixed string "default") holding
/// every business rule the Phase 6 approval explicitly required be
/// configurable rather than hardcoded: commission rate, SUPPORT's refund
/// authority limit, the subscription past-due grace period, and the
/// abandoned-booking TTL. Every consumer reads this row — nothing here is
/// a `const` in application code. Admin-editable (Phase 6.10); reads are
/// unauthenticated-safe internally (server-only) since the values
/// themselves aren't secret, only writable by ADMIN.
model PaymentPolicy {
  id String @id @default("default")

  /// Platform commission on a tutor booking, in basis points (2000 =
  /// 20.00%). Default matches the approved Phase 6 decision.
  commissionBasisPoints Int @default(2000) @map("commission_basis_points")

  /// Max refund amount (cents) a SUPPORT-role user may initiate without
  /// ADMIN approval. Above this, ADMIN is required.
  supportRefundLimitCents Int @default(5000) @map("support_refund_limit_cents")

  /// Days a subscription may stay PAST_DUE before entitlements are
  /// server-side paused back to FREE (Phase 6.11).
  pastDueGracePeriodDays Int @default(7) @map("past_due_grace_period_days")

  /// Minutes an unpaid PENDING booking holds its slot before being
  /// auto-released (Phase 6.7).
  abandonedBookingTtlMinutes Int @default(15) @map("abandoned_booking_ttl_minutes")

  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("payment_policies")
}
